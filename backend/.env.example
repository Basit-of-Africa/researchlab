# ---------------------------------------------------------------------------
# ResearchLab backend configuration. Copy to .env (never commit .env).
# All secrets live here, server-side only. Nothing is exposed to the frontend.
# ---------------------------------------------------------------------------
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO

# Neon: use the pooled or direct connection string, with the psycopg driver prefix
# e.g. postgresql+psycopg://user:pass@ep-xxx.eu-central-1.aws.neon.tech/researchlab?sslmode=require
DATABASE_URL=postgresql+psycopg://researchlab:researchlab@localhost:5432/researchlab

# 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-of-at-least-32-chars
ACCESS_TOKEN_MINUTES=720
COOKIE_SECURE=false                # true in production (HTTPS)
COOKIE_SAMESITE=lax                # use "none" (+ COOKIE_SECURE=true) only if frontend and API are on different sites
ALLOW_REGISTRATION=false           # single-researcher: only the first account can register
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- File storage --------------------------------------------------------------
MAX_UPLOAD_MB=40
STORAGE_BACKEND=local              # local | supabase  (use supabase on ephemeral hosts such as Render free)
LOCAL_STORAGE_PATH=./storage_data
SUPABASE_URL=
SUPABASE_SERVICE_KEY=              # service-role key; server-side only
SUPABASE_BUCKET=researchlab        # create as a PRIVATE bucket

# --- AI inference (priority order; later entries are fallbacks) ---------------------
LLM_PROVIDERS=gemini,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Any OpenAI-compatible endpoint (Groq, OpenRouter, LM Studio, vLLM). Add "openai_compat" to LLM_PROVIDERS to use it.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3

# --- Embeddings (768 dimensions) ---------------------------------------------------
EMBEDDING_PROVIDER=hashing         # hashing | sentence_transformers | ollama | gemini
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-mpnet-base-v2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Scholarly sources ---------------------------------------------------------------
SCHOLARLY_CONTACT_EMAIL=           # optional; joins the OpenAlex/Crossref "polite pool"
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=          # optional; without it the shared rate limit applies
CORE_API_KEY=                      # free key from https://core.ac.uk/services/api
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# --- Background processing & analysis sandbox ----------------------------------------
RUN_EMBEDDED_WORKER=true           # run the job worker inside the API process (free tiers)
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=300
WATCH_CHECK_MINUTES=60
ANALYSIS_TIMEOUT_SECONDS=120
ANALYSIS_MEMORY_MB=1024
